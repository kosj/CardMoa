# Supabase (공개 키 — 클라이언트 노출 허용)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Supabase 서비스 롤 키 (서버 전용, 절대 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Google Gemini API 키
GEMINI_API_KEY=AIzaSy...

# 웹훅 공유 시크릿 (외부 앱과 동일한 값 사용)
WEBHOOK_SECRET=change-me-to-a-strong-random-string

# 가족 암호 (서버 전용 — 절대 NEXT_PUBLIC_ 를 붙이지 마세요)
# /dashboard(생활 노트·추억 사진)는 이 암호를 아는 가족만 열 수 있어요.
# 생일·전화번호·이름처럼 짐작하기 쉬운 값 말고, 가족만 아는 단어 3~4개를 이어 붙인 긴 암호를 추천해요.
# 값을 바꾸면 이미 열어 둔 모든 기기가 다시 잠겨요. 비워 두면 노트는 항상 잠겨 있어요.
# Vercel: Settings → Environment Variables 에 추가한 뒤 Redeploy
FAMILY_PASSCODE=
